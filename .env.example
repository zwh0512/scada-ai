# ============================================================
# 阿里百炼 API Key —— 复制这个文件为 .env 再填
# ============================================================
# .env 已被 .gitignore 忽略, 不会进版本库。
#
# 获取地址: https://bailian.console.aliyun.com/  ->  API-KEY 管理
# 免费额度: 新用户有百万级 token, 够学习和小规模测试用。
#
# 用法:
#   1. cp .env.example .env      (Windows: copy .env.example .env)
#   2. 把下面这行填上你的 key
#   3. python llm_diagnose.py
#
# 也可以不用 .env, 直接设环境变量:
#   $env:DASHSCOPE_API_KEY = "sk-xxxxxxxx"
#
# 没配 key 也能跑:
#   python llm_diagnose.py --offline     # 用规则模拟大模型, 验证工具调用链路

DASHSCOPE_API_KEY=
